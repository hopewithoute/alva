{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "vue": ["node_modules/vue"],
      "live_vue": ["../deps/live_vue/assets"],
      "alva/useAlvaApi": ["../../alva/assets/js/useAlvaApi"],
      "alva": ["../../alva/assets/js"],
      "phoenix": ["../deps/phoenix"],
      "phoenix_live_view": ["../deps/phoenix_live_view"]
    },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["js/**/*.ts", "js/**/*.js", "vue/**/*.vue"],
  "exclude": ["../deps", "node_modules"]
}
