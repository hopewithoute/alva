  +<script setup lang="ts">
  +import { useAlvaApi, ashForm } from 'alva'
  +import { ref, onMounted } from 'vue'
  +import { Events } from '../js/alva/events'
  +
  +const api = useAlvaApi<Events>()
  +
  +const { data: messages } = api.bind_stream('messages', [])
  +
  +const form = ashForm(api, 'messages.create', {
  +  initialValues: { content: '', username: 'Guest' },
  +  onOptimisticSubmit: (data) => {
  +    const tempId = `temp-${Date.now()}`
  +    const tempMessage = { ...data, id: tempId, inserted_at: new Date().toISOString() }
  +    
  +    messages.value.push(tempMessage as any)
  +    
  +    const prevContent = data.content
  +    form.values.content = ''
  +    
  +    return () => {
  +      messages.value = messages.value.filter((m: any) => m.id !== tempId)
  +      form.values.content = prevContent
  +    }
  +  }
  +})
  +
  +onMounted(async () => {
  +  const result = await api.call('messages.list')
  +  if (result.ok) {
  +    messages.value = result.data
  +  }
  +})
  +</script>
  +
  +<template>
  +  <div class="border rounded shadow-md p-6 bg-white">
  +    <div class="h-80 overflow-y-auto mb-4 border-b flex flex-col gap-3 p-4">
